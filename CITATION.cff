    name-suffix: III
    orcid: https://orcid.org/0000-0001-5267-1672
    affiliation: Scripps Research Institute
repository-code: https://github.com/tacular-omics/tacular-omics
license: MIT
keywords:
  - Python
  - Proteomics
  - Mass spectrometry
  - Bioinformatics
